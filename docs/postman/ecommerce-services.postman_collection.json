      "name": "User Service via Gateway",
      "item": [
        {
          "name": "Sign Up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.access_token) pm.collectionVariables.set('access_token', data.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Lucas\",\n  \"lastName\": \"Silva\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"11999999999\",\n  \"address\": \"Rua Exemplo, 123\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/user/sign-up",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "user",
                "sign-up"
              ]
            },
            "description": "Cadastro de usuario. Retorna access_token e cria cookie refresh_token."
          },
          "response": []
        },
        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.access_token) pm.collectionVariables.set('access_token', data.access_token);",
                  "  const refreshCookie = pm.cookies.get('refresh_token');",
                  "  if (refreshCookie) pm.collectionVariables.set('refresh_token', refreshCookie);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{email}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/user/sign-in",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "user",
                "sign-in"
              ]
            },
            "description": "Login via HTTP Basic. Retorna access_token."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.access_token) pm.collectionVariables.set('access_token', data.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{refresh_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/user/refresh-token",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "api",
                "user",
                "refresh-token"
              ]
            },
            "description": "Gera novo access_token usando refresh token no header Authorization: Bearer."
          },
          "response": []
        },
